  m_Name: Decision_MarketWaste
  m_EditorClassIdentifier: Assembly-CSharp::ConNuoc.Data.DecisionSO
  decisionId: market_waste
  npcName: "C\xF4 Hoa (market)"
  requiredTier: 0
  requiredFlag: 
  oneTimeOnly: 1
  promptText: '"People tip their rubbish by the drain because the market has nowhere else to put it. When the rain comes it washes straight into the water, and my customers can''t reach the stalls when the road floods."'
  promptVariants:
  - requiredFlag: reeds_kept
    promptText: "\"Ch\xFA T\u01B0 told me you asked him to leave the reeds. Thank you, con. People are starting to notice the small things. Now, about the rubbish by the drain: the market has nowhere to put it.\""
  - requiredFlag: reeds_cleared
    promptText: '"I hear the reeds are going from the bank. When the rain comes, the water will have a clear run to my stalls. Can you help with the rubbish at least? The market has nowhere to put it."'
  options:
  - optionText: Help her set up bins and a collection spot at the market.
    requiredTier: 0
    immediateDeltas:
    - meter: 1
      amount: 10
    - meter: 0
      amount: 5
    - meter: 2
      amount: -10
    unlocksTier: 1
    tierUnlocked: 1
