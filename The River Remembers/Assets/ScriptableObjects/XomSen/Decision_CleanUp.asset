  decisionId: clean_up
  npcName: "B\xE0 S\xE1u"
  requiredTier: 1
  requiredFlag: 
  oneTimeOnly: 1
  promptText: '"You''ve listened, con. If the neighbours pitch in, we could clear the drain together and replant the bank. It''s more than one girl can do, but it isn''t more than a village can do."'
  promptVariants:
  - requiredFlag: bins_set
    promptText: '"The market bins are working, and people are talking about it. You''ve been listening, con. If the neighbours pitch in, we could clear the drain together and replant the bank."'
  - requiredFlag: reeds_kept
    promptText: "\"You asked Ch\xFA T\u01B0 to leave the reeds, and he did. People noticed. If the neighbours pitch in, we could clear the drain together and replant the bank. It isn't more than a village can do.\""
  options:
  - optionText: Organise the neighbourhood clean-up and replanting.
    requiredTier: 1
    immediateDeltas:
    - meter: 1
      amount: 15
    - meter: 0
      amount: 10
    - meter: 2
      amount: -10
    unlocksTier: 1
    tierUnlocked: 2
    setsFlag: cleanup_done
    hasDelayedConsequence: 0
